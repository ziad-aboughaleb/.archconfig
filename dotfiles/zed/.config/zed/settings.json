{
  "ui_font_family": "Noto Sans",
  "ui_font_size": 16,
  "theme": "Noctalia Dark",
  "icon_theme": {
    "dark": "Warm Charmed Icons",
    "light": "Light Charmed Icons",
    "mode": "dark"
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "preferred_line_length": 120,
  "show_wrap_guides": false,
  "soft_wrap": "bounded",
  "tab_size": 2,
  "colorize_brackets": true,
  "buffer_font_features": {
    "calt": false
  },
  "indent_guides": {
    "active_line_width": 2,
    "coloring": "indent_aware",
    "line_width": 2
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "default_width": 400,
    "hide_root": true,
    "indent_guides": {
      "show": "never"
    }
  },
  "git_panel": {
    "default_width": 400,
    "tree_view": true
  },
  "outline_panel": {
    "default_width": 400,
    "indent_guides": {
      "show": "never"
    }
  },
  "collaboration_panel": {
    "default_width": 400
  },
  "terminal": {
    "scrollbar": {
      "show": "never"
    },
    "cursor_shape": "block",
    "default_height": 400
  },
  "agent": {
    "default_width": 400,
    "flexible": false,
    "dock": "right"
  },
  "minimap": {
    "thumb": "hover"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": true
    }
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "toolbar": {
    "breadcrumbs": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
    "quick_actions": false
  },
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "formatter": {
    "external": {
      "command": "treefmt",
      "arguments": [
        "--config-file",
        "/home/ziad/.config/treefmt/.treefmt.toml",
        "--stdin",
        "{buffer_path}"
      ]
    }
  },
  "lsp_document_colors": "inlay",
  "cli_default_open_behavior": "existing_window",
  "load_direnv": "direct",
  "restore_on_startup": "launchpad",
  "session": {
    "trust_all_worktrees": true
  },
  "node": {
    "ignore_system_version": true
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
