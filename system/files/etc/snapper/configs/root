# /etc/snapper/configs/root

# ==========================================
# 1. CORE FILESYSTEM
# ==========================================
SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP=""

# ==========================================
# 2. SPACE LIMITS & ACCESS
# ==========================================
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
UNIQUE_NUMBERS="yes"
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"

# ==========================================
# 3. PACMAN / EVENT SNAPSHOTS (NUMBER LIMITS)
# ==========================================
# Limits how many pre/post snapshots are kept when pacman installs updates.
# 50 is massive overkill; 10 gives you plenty of rollback options without bloat.
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="10"
NUMBER_LIMIT_IMPORTANT="5"

# ==========================================
# 4. TIMELINE SNAPSHOTS (DISABLED)
# ==========================================
# Arch is a rolling release. You want snapshots when you UPDATE the system,
# not arbitrarily every hour. Relying on pacman hooks instead of timers
# saves massive amounts of disk space.
TIMELINE_CREATE="no"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="0"
TIMELINE_LIMIT_DAILY="0"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="0"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="0"

# ==========================================
# 5. EMPTY SNAPSHOT CLEANUP
# ==========================================
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
